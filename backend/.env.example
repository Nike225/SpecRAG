# LLM: ollama | openai | anthropic | extractive (no LLM, offline)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embeddings: ollama | sentence-transformers | openai | lsa (offline)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Retrieval
RETRIEVAL_MODE=hybrid
TOP_K_CONTEXT=6
RERANKER=none            # none | cross-encoder | llm
ABSTAIN_THRESHOLD=0.08
ABSTAIN_DENSE_THRESHOLD=0  # tune with eval/run_eval.py (dense_best row)
